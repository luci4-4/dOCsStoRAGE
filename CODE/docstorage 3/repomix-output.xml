  const submit = async e => {
    e.preventDefault(); setSaving(true)
    try { await api.post('/sources', form); toast.success('Источник добавлен'); onSave() }
    catch { toast.error('Ошибка') } finally { setSaving(false) }
  }
  return (
    <div className="modal-overlay" onClick={onClose}>
      <div className="modal" onClick={e => e.stopPropagation()}>
        <div className="modal-header"><span className="modal-title">Новый источник</span><button type="button" className="icon-btn" onClick={onClose} aria-label="Закрыть">×</button></div>
