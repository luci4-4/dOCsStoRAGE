import { useEffect, useState } from 'react'
import { useSearchParams, Link } from 'react-router-dom'
import api from '../api/client'
import { useAuth } from '../context/AuthContext'
import PageHeader from '../components/PageHeader'
import Icon from '../components/Icon'

const LANGS = ['Все', 'JavaScript', 'Python', 'PHP', 'TypeScript', 'Go', 'Rust']

export default function SearchPage() {
  const { user } = useAuth()
  const [sp] = useSearchParams()
  const q = sp.get('q') || ''
  const [results, setResults] = useState([])
  const [loading, setLoading] = useState(false)
  const [filter, setFilter] = useState('Все')
  const [scope, setScope] = useState('all')

  useEffect(() => {
    if (!q) return
    setLoading(true)
    api.get('/search', {
      params: {
        q,
        lang: filter === 'Все' ? undefined : filter,
        mine: scope === 'mine' ? 1 : undefined,
      },
    })
      .then(r => setResults(r.data.hits || []))
      .catch(() => setResults([]))
      .finally(() => setLoading(false))
  }, [q, filter, scope])

  return (
    <div style={{ maxWidth: 800 }}>
      <PageHeader
        icon="search"
        title={q ? <>Результаты: <span className="accent-text">«{q}»</span></> : 'Поиск'}
        subtitle={!loading && results.length > 0 ? `${results.length} результатов` : undefined}
      />

      <div className="filter-bar">
        {LANGS.map(l => (
          <button key={l} type="button" className={'filter-chip' + (filter === l ? ' active' : '')} onClick={() => setFilter(l)}>
            {l}
          </button>
        ))}
        {user && (
          <>
            <span className="filter-divider" />
            <button type="button" className={'filter-chip' + (scope === 'all' ? ' active' : '')} onClick={() => setScope('all')}>Везде</button>
            <button type="button" className={'filter-chip' + (scope === 'mine' ? ' active' : '')} onClick={() => setScope('mine')}>Мои файлы</button>
          </>
        )}
      </div>

      <div className="card">
        {loading ? (
          <div className="page-loading"><span className="spinner spinner-dark" /></div>
        ) : results.length === 0 ? (
          <div className="empty-state"><Icon name="search" size={40} />{q ? 'Ничего не найдено' : 'Введите запрос на главной'}</div>
        ) : (
          results.map(r => (
            <Link key={r.id} to={`/docs/${r.id}`} className="result-item-link">
              <div className="result-item">
                <div className="result-source">{r.source} / {r.language}</div>
                <div className="result-title" dangerouslySetInnerHTML={{ __html: r._formatted?.title || r.title }} />
                <div className="result-snippet" dangerouslySetInnerHTML={{ __html: (r._formatted?.content || r.content || '').slice(0, 180) + '...' }} />
              </div>
            </Link>
          ))
        )}
      </div>
    </div>
  )
}
</file>

